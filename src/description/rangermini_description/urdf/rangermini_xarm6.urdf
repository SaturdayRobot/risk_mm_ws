    </joint>
    <joint name="joint_steer_rr">
      <command_interface name="position" />
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
      <param name="pos_kp">300.0</param>
      <param name="pos_ki">10.0</param>
      <param name="pos_kd">3.0</param>
      <param name="pos_max_integral_error">2.0</param>
      <param name="pos_min_integral_error">-2.0</param>
    </joint>
    <joint name="joint_wheel_fl">
      <command_interface name="velocity" />
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
      <param name="vel_kp">12.0</param>
      <param name="vel_ki">80.0</param>
      <param name="vel_kd">0.0</param>
      <param name="vel_max_integral_error">3.0</param>
      <param name="vel_min_integral_error">-3.0</param>
      <param name="vel_antiwindup">true</param>
    </joint>
    <joint name="joint_wheel_fr">
      <command_interface name="velocity" />
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
      <param name="vel_kp">12.0</param>
      <param name="vel_ki">80.0</param>
      <param name="vel_kd">0.0</param>
      <param name="vel_max_integral_error">3.0</param>
      <param name="vel_min_integral_error">-3.0</param>
      <param name="vel_antiwindup">true</param>
    </joint>
    <joint name="joint_wheel_rl">
      <command_interface name="velocity" />
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
      <param name="vel_kp">12.0</param>
      <param name="vel_ki">80.0</param>
      <param name="vel_kd">0.0</param>
      <param name="vel_max_integral_error">3.0</param>
      <param name="vel_min_integral_error">-3.0</param>
      <param name="vel_antiwindup">true</param>
    </joint>
    <joint name="joint_wheel_rr">
      <command_interface name="velocity" />
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
      <param name="vel_kp">12.0</param>
      <param name="vel_ki">80.0</param>
      <param name="vel_kd">0.0</param>
      <param name="vel_max_integral_error">3.0</param>
      <param name="vel_min_integral_error">-3.0</param>
      <param name="vel_antiwindup">true</param>
    </joint>
    <joint name="xarm6_joint1">
      <command_interface name="position" />
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
      <param name="pos_kp">1500.0</param>
      <param name="pos_ki">30.0</param>
      <param name="pos_kd">10.0</param>
      <param name="pos_max_integral_error">2.0</param>
      <param name="pos_min_integral_error">-2.0</param>
    </joint>
    <joint name="xarm6_joint2">
      <command_interface name="position" />
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
      <param name="pos_kp">2000.0</param>
      <param name="pos_ki">50.0</param>
      <param name="pos_kd">15.0</param>
      <param name="pos_max_integral_error">2.0</param>
      <param name="pos_min_integral_error">-2.0</param>
    </joint>
    <joint name="xarm6_joint3">
      <command_interface name="position" />
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
      <param name="pos_kp">1200.0</param>
      <param name="pos_ki">40.0</param>
      <param name="pos_kd">6.0</param>
      <param name="pos_max_integral_error">2.0</param>
      <param name="pos_min_integral_error">-2.0</param>
    </joint>
    <joint name="xarm6_joint4">
      <command_interface name="position" />
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
      <param name="pos_kp">600.0</param>
      <param name="pos_ki">20.0</param>
      <param name="pos_kd">0.5</param>
      <param name="pos_max_integral_error">2.0</param>
      <param name="pos_min_integral_error">-2.0</param>
    </joint>
    <joint name="xarm6_joint5">
      <command_interface name="position" />
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
      <param name="pos_kp">400.0</param>
      <param name="pos_ki">20.0</param>
      <param name="pos_kd">0.3</param>
      <param name="pos_max_integral_error">2.0</param>
      <param name="pos_min_integral_error">-2.0</param>
    </joint>
    <joint name="xarm6_joint6">
      <command_interface name="position" />
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
      <param name="pos_kp">100.0</param>
      <param name="pos_ki">10.0</param>
      <param name="pos_kd">0.04</param>
      <param name="pos_max_integral_error">2.0</param>
      <param name="pos_min_integral_error">-2.0</param>
    </joint>
  </ros2_control>
  <gazebo>
    <selfCollide>false</selfCollide>
  </gazebo>
  <gazebo>
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
      <parameters>$(find mm_bringup)/config/ros2_control.yaml</parameters>
      <robot_param>robot_description</robot_param>
      <robot_param_node>robot_state_publisher</robot_param_node>
      <control_period>0.002</control_period>
    </plugin>
    <plugin filename="libgazebo_ros_p3d.so" name="p3d_base_odom">
      <ros>
        <namespace>/mm/car</namespace>
        <remapping>odom:=/ground_truth/odom</remapping>
      </ros>
      <body_name>base_link</body_name>
      <frame_name>world</frame_name>
      <update_rate>100</update_rate>
      <gaussian_noise>0.0</gaussian_noise>
      <publish_tf>false</publish_tf>
    </plugin>
  </gazebo>
  <gazebo reference="head_camera_link">
    <sensor type="camera" name="head_camera">
      <update_rate>15</update_rate>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>30</far>
        </clip>
      </camera>
      <plugin filename="libgazebo_ros_camera.so" name="head_camera_plugin">
        <ros>
          <namespace>/camera</namespace>
          <remapping>image_raw:=head/image_raw</remapping>
          <remapping>camera_info:=head/camera_info</remapping>
        </ros>
        <camera_name>head</camera_name>
        <frame_name>head_camera_optical_frame</frame_name>
      </plugin>
    </sensor>
  </gazebo>
  <gazebo reference="lidar_link">
    <sensor type="gpu_ray" name="lidar3d">
      <pose>0 0 0 0 0 0</pose>
      <always_on>1</always_on>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>900</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
          <vertical>
            <samples>16</samples>
            <resolution>1</resolution>
            <min_angle>-0.2617993877991494</min_angle>
            <max_angle>0.2617993877991494</max_angle>
          </vertical>
        </scan>
        <range>
          <min>.2</min>
          <max>30.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <plugin filename="libgazebo_ros_ray_sensor.so" name="lidar3d_plugin">
        <ros>
          <namespace>/lidar</namespace>
          <remapping>~/out:=/rslidar_points</remapping>
        </ros>
        <output_type>sensor_msgs/PointCloud2</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>
  <link name="front_camera_link" />
  <joint name="front_camera_link_joint" type="fixed">
    <parent link="base_link" />
    <child link="front_camera_link" />
    <origin xyz="-0.324 0.048 0.542" rpy="0.0 0.0 3.141592653589793" />
  </joint>
  <link name="imu_link" />
  <joint name="imu_link_joint" type="fixed">
    <parent link="base_link" />
    <child link="imu_link" />
    <origin xyz="0.0 0.0 0.35" rpy="0.0 0.0 0.0" />
  </joint>
  <link name="camera_depth_optical_frame" />
  <joint name="camera_depth_optical_frame_joint" type="fixed">
    <parent link="front_camera_link" />
    <child link="camera_depth_optical_frame" />
    <origin xyz="0 0 0" rpy="-1.5707963267948966 0 -1.5707963267948966" />
  </joint>
  <link name="camera_color_optical_frame" />
  <joint name="camera_color_optical_frame_joint" type="fixed">
    <parent link="front_camera_link" />
    <child link="camera_color_optical_frame" />
    <origin xyz="0 0 0" rpy="-1.5707963267948966 0 -1.5707963267948966" />
  </joint>
  <link name="camera_imu_link" />
  <joint name="camera_imu_link_joint" type="fixed">
    <parent link="front_camera_link" />
    <child link="camera_imu_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>
  <!-- CAD lens center on the face with the square panel and circular lens. -->
  <link name="head_camera_link" />
  <joint name="head_camera_mount" type="fixed">
    <parent link="head_link" />
    <child link="head_camera_link" />
    <origin xyz="-0.005980921 0.068711959 0.012817872" rpy="0.132419768 -0.056003871 1.252244922" />
  </joint>
  <link name="head_camera_optical_frame" />
  <joint name="head_camera_optical_frame_joint" type="fixed">
    <parent link="head_camera_link" />
    <child link="head_camera_optical_frame" />
    <origin xyz="0 0 0" rpy="-1.5707963267948966 0 -1.5707963267948966" />
  </joint>
  <gazebo reference="front_camera_link">
    <sensor type="depth" name="d435i_rgbd">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <camera>
        <horizontal_fov>1.5184364492350666</horizontal_fov>
        <image>
          <width>424</width>
          <height>240</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.15</near>
          <far>8.0</far>
        </clip>
      </camera>
      <plugin name="d435i_rgbd_plugin" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/camera</namespace>
          <remapping>d435i/image_raw:=color/image_raw</remapping>
          <remapping>d435i/camera_info:=color/camera_info</remapping>
          <remapping>d435i/depth/image_raw:=depth/image_rect_raw</remapping>
          <remapping>d435i/depth/camera_info:=depth/camera_info</remapping>
          <remapping>d435i/points:=depth/color/points</remapping>
        </ros>
        <camera_name>d435i</camera_name>
        <frame_name>camera_depth_optical_frame</frame_name>
        <min_depth>0.15</min_depth>
        <max_depth>8.0</max_depth>
      </plugin>
    </sensor>
  </gazebo>
  <gazebo reference="imu_link">
    <sensor type="imu" name="hi226">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <imu />
      <plugin name="hi226_plugin" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <remapping>~/out:=/imu/data_raw</remapping>
        </ros>
        <frame_name>imu_link</frame_name>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
      </plugin>
    </sensor>
  </gazebo>
  <gazebo reference="camera_imu_link">
    <sensor type="imu" name="d435i_imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <imu />
      <plugin name="d435i_imu_plugin" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <remapping>~/out:=/camera/imu</remapping>
        </ros>
        <frame_name>camera_imu_link</frame_name>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
      </plugin>
    </sensor>
  </gazebo>
</robot>
