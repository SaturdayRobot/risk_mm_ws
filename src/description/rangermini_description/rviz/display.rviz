Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.5
      Plane Cell Count: 20
      Color: 160; 160; 164
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Topic:
        Value: /robot_description
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Show Names: true
      Marker Scale: 0.3
    - Class: rviz_default_plugins/Axes
      Name: Camera optical axis (blue Z forward)
      Enabled: true
      Reference Frame: head_camera_optical_frame
      Length: 0.18
      Radius: 0.004
    - Class: rviz_default_plugins/Path
      Name: Coupled candidate
      Enabled: true
      Topic:
        Value: /coupled/candidate_path
        Durability Policy: Transient Local
      Color: 255; 160; 20
      Line Width: 0.01
    - Class: rviz_default_plugins/Path
      Name: Validated coupled path
      Enabled: true
      Topic:
        Value: /coupled/validated_path
        Durability Policy: Transient Local
      Color: 30; 230; 80
      Line Width: 0.015
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: base_link
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 3.2
      Focal Point:
        X: -0.1
        Y: 0
        Z: 0.8
      Pitch: 0.3
      Yaw: 3.7
